datadir="/var/lib/proxysql"

admin_variables=
{
  admin_credentials="admin:admin_pass"
  mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
  interfaces="0.0.0.0:6033"
  monitor_username="monitor"
  monitor_password="monitor_pass"
  monitor_replication_lag_interval=1000
  monitor_ping_interval=2000
}

mysql_servers=
(
  { address="mysql-primary", port=3306, hostgroup=10, weight=100 },
  { address="mysql-replica", port=3306, hostgroup=20, weight=100 }
)

mysql_users=
(
  { username="laravel", password="laravel_pass", default_hostgroup=10 }
)

mysql_query_rules=
(
  { rule_id=1, match_pattern="^SELECT", destination_hostgroup=20, apply=1 },
  { rule_id=2, match_pattern=".*",      destination_hostgroup=10, apply=1 }
)
